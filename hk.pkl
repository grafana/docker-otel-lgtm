// Builtins own tool invocations; native tool configs own repository policy.
amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

// Generated dependency inventories are maintained by their own tools.
exclude = List("**/package-lock.json", "mise.lock", ".cache/**")

steps {
  ["actionlint"] = Builtins.actionlint
  ["biome"] = Builtins.biome
  ["destroyed-symlinks"] = Builtins.destroyed_symlinks
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["golangci-lint"] = Builtins.golangci_lint
  ["google-java-format"] = Builtins.google_java_format
  ["hadolint"] = Builtins.hadolint
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = Builtins.ruff_format
  ["rumdl"] = Builtins.rumdl
  ["ryl"] = Builtins.ryl
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["taplo-format"] = Builtins.taplo_format
  ["pkl-format"] = Builtins.pkl_format
  ["typos"] = Builtins.typos
  ["gofmt"] = Builtins.go_fmt
  ["cargo-clippy"] = Builtins.cargo_clippy
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["dotnet-format"] = new Config.Step {
    glob = List("**/*.cs", "**/*.vb")
    exclusive = true
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("dotnet", "format", "--verify-no-changes", "--include", "{{files}}")
      }
      // Implicit restore may write obj/ even in verification mode.
      effect = "write"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("dotnet", "format", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
  // Repository policy: only k8s/ contains Kubernetes manifests (not other YAML).
  // Unlike the builtin defaults, validate against API 1.35.0 and fail when a
  // schema is missing. Keep these choices when replacing the command with options.
  ["kubeconform"] = (Builtins.kubeconform) {
    glob = List("k8s/**/*.yaml", "k8s/**/*.yml")
    check = new Config.CommandSpec {
      command = "kubeconform -summary -strict -kubernetes-version 1.35.0 {{files}}"
      effect = "read"
    }
  }
  ["kube-linter"] = new Config.Step {
    glob = List("k8s/**/*.yaml", "k8s/**/*.yml")
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("kube-linter", "lint", "--fail-if-no-objects-found", "{{files}}")
      }
      effect = "read"
    }
  }
  ["xmllint"] = Builtins.xmllint
  // Flint still owns dependency consistency and repository-aware link checking.
  ["renovate-deps"] = new Config.Step {
    // The checker filters relevance; snapshot extraction must not race fixers.
    exclusive = true
    stdin = "{{ files_list | join(sep='\n') }}"
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("flint", "checker", "renovate-deps", "--files-from", "-")
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("flint", "checker", "renovate-deps", "--files-from", "-", "--fix")
      }
      effect = "write"
    }
    stage = List(".github/renovate-tracked-deps.json", "mise.toml", ".github/renovate.json5")
    diagnostic_format = "sarif"
  }
  ["lychee"] = new Config.Step {
    glob =
      List(
        "**/*.md",
        "**/*.mkd",
        "**/*.mdx",
        "**/*.mdown",
        "**/*.mdwn",
        "**/*.mkdn",
        "**/*.mkdown",
        "**/*.markdown",
        "**/*.html",
        "**/*.htm",
        "**/*.txt",
      )
    stdin = "{{ files_list | join(sep='\n') }}"
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("flint", "checker", "lychee", "--files-from", "-")
      }
      effect = "read"
    }
    diagnostic_format = "sarif"
  }
}
