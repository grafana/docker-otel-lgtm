// Exploration: prefer hk builtins; keep only intentional repository policy.
// Pin a current builtin set, including editorconfig-checker v4 support.
amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

// Generated dependency inventories are maintained by their own tools.
exclude = List("**/package-lock.json", "mise.lock", ".cache/**")

steps = new Mapping<String, Config.Step> {
  ["actionlint"] = Builtins.actionlint
  ["biome"] = (Builtins.biome) {
    exclude = ".github/renovate-tracked-deps.json"
  }
  // Existing formatter ownership policy. Revisit with concrete conflicting
  // findings rather than extending this list to mimic Flint automatically.
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    exclude =
      List(
        "**/*.bash",
        "**/*.bats",
        "**/*.cs",
        "**/*.go",
        "**/*.htm",
        "**/*.html",
        "**/*.java",
        "**/*.js",
        "**/*.json",
        "**/*.jsonc",
        "**/*.jsx",
        "**/*.md",
        "**/*.mdown",
        "**/*.mdx",
        "**/*.mkd",
        "**/*.mkdn",
        "**/*.mkdown",
        "**/*.markdown",
        "**/*.mdwn",
        "**/*.py",
        "**/*.rs",
        "**/*.sh",
        "**/*.toml",
        "**/*.ts",
        "**/*.tsx",
        "**/*.yaml",
        "**/*.yml",
      )
  }
  ["golangci-lint"] = (Builtins.golangci_lint) {
    dir = "."
    // Each module shares golangci-lint's cache lock. Wait rather than fail.
    // Resolve the shared config before entering each Go module.
    check = new Config.CommandSpec {
      command =
        "config=\"$PWD/.github/config/.golangci.yml\"; cd {{workspace}} && golangci-lint run --allow-serial-runners --fix=false --config \"$config\" ./..."
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command =
        "config=\"$PWD/.github/config/.golangci.yml\"; cd {{workspace}} && golangci-lint run --allow-serial-runners --fix --config \"$config\" ./..."
      effect = "write"
    }
  }
  ["google-java-format"] = Builtins.google_java_format
  ["hadolint"] = Builtins.hadolint
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = Builtins.ruff_format
  ["rumdl"] = (Builtins.rumdl) {
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("rumdl", "check", "--config", ".github/config/.rumdl.toml", "{{files}}")
      }
      effect = "read"
    }
    check_diff = new Config.CommandSpec {
      command = new Config.Command {
        argv =
          List("rumdl", "check", "--config", ".github/config/.rumdl.toml", "--diff", "{{files}}")
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv =
          List("rumdl", "check", "--config", ".github/config/.rumdl.toml", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  ["ryl"] = (Builtins.ryl) {
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("ryl", "-c", ".github/config/.yamllint.yml", "{{files}}")
      }
      effect = "read"
    }
    check_diff = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("ryl", "-c", ".github/config/.yamllint.yml", "--diff", "{{files}}")
      }
      effect = "read"
    }
    check_list_files = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("ryl", "-c", ".github/config/.yamllint.yml", "--list-files", "{{files}}")
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("ryl", "-c", ".github/config/.yamllint.yml", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  ["shellcheck"] = (Builtins.shellcheck) {
    check = new Config.CommandSpec {
      command = "shellcheck -x -P SCRIPTDIR {{files}}"
      effect = "read"
    }
  }
  // Include Bats and extensionless scripts rather than narrowing to Flint's scope.
  ["shfmt"] = Builtins.shfmt
  ["taplo-format"] = Builtins.taplo_format
  ["pkl-format"] = Builtins.pkl_format
  ["typos"] = (Builtins.typos) {
    check_diff = new Config.CommandSpec {
      command =
        """
        output=$(typos --config .github/config/_typos.toml --force-exclude --diff {{files}})
        [ -z "$output" ] && exit 0
        printf "%s" "$output"
        exit 1
        """
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command =
        "typos --config .github/config/_typos.toml --force-exclude --write-changes {{files}}"
      effect = "write"
    }
  }
  ["gofmt"] = Builtins.go_fmt
  ["cargo-clippy"] = Builtins.cargo_clippy
  ["cargo-fmt"] = (Builtins.cargo_fmt) {
    check = new Config.CommandSpec {
      command =
        "cargo fmt --manifest-path {{workspace_indicator}} -- --config-path .github/config/rustfmt.toml --check"
      effect = "read"
    }
    check_list_files = new Config.CommandSpec {
      command =
        "cargo fmt --manifest-path {{workspace_indicator}} -- --config-path .github/config/rustfmt.toml --check --files-with-diff"
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command =
        "cargo fmt --manifest-path {{workspace_indicator}} -- --config-path .github/config/rustfmt.toml"
      effect = "write"
    }
  }
  // Replace with the upstream builtin once available; keep the same contract here.
  ["dotnet-format"] = new Config.Step {
    glob = List("**/*.cs", "**/*.vb")
    exclusive = true
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("dotnet", "format", "--verify-no-changes", "--include", "{{files}}")
      }
      // Implicit restore may write obj/ even in verification mode.
      effect = "write"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("dotnet", "format", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
  ["kube-linter"] = new Config.Step {
    glob =
      List(
        "k8s/**/*.yml",
        "k8s/**/*.yaml",
        "kubernetes/**/*.yml",
        "kubernetes/**/*.yaml",
        "manifests/**/*.yml",
        "manifests/**/*.yaml",
      )
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv =
          List("kube-linter", "lint", "--config", ".github/config/kube-linter.yaml", "{{files}}")
      }
      effect = "read"
    }
  }
  ["xmllint"] = Builtins.xmllint
  // Temporary Flint-owned adapters: retain until focused probes justify replacing
  // their additional policy. Pass hk's exact newline-delimited selection,
  // without asking Flint to rediscover changed files.
  ["renovate-deps"] = new Config.Step {
    // Pass all selected paths: the checker owns offline relevance matching for
    // manifests, mise, workflows and Renovate config. Filtering only Renovate
    // config here would silently skip dependency edits in changed-file runs.
    // Snapshot extraction observes project-wide state; do not race other fixers.
    exclusive = true
    stdin = "{{ files_list | join(sep='\n') }}"
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("flint", "checker", "renovate-deps", "--files-from", "-")
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("flint", "checker", "renovate-deps", "--files-from", "-", "--fix")
      }
      effect = "write"
    }
    stage =
      List(
        "renovate-tracked-deps.json",
        ".github/renovate-tracked-deps.json",
        "mise.toml",
        "renovate.json",
        "renovate.json5",
        ".github/renovate.json",
        ".github/renovate.json5",
        ".renovaterc",
        ".renovaterc.json",
        ".renovaterc.json5",
      )
    diagnostic_format = "sarif"
  }
  ["lychee"] = new Config.Step {
    glob =
      List(
        "**/*.md",
        "**/*.mkd",
        "**/*.mdx",
        "**/*.mdown",
        "**/*.mdwn",
        "**/*.mkdn",
        "**/*.mkdown",
        "**/*.markdown",
        "**/*.html",
        "**/*.htm",
        "**/*.txt",
      )
    stdin = "{{ files_list | join(sep='\n') }}"
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("flint", "checker", "lychee", "--files-from", "-")
      }
      effect = "read"
    }
    diagnostic_format = "sarif"
  }
}
